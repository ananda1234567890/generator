# Copy to .env.local (on your Mac) or add these in Vercel -> Settings -> Environment Variables.

# Login: one shared password for the dashboard, plus a long random string used to sign the session cookie.
APP_PASSWORD=
SESSION_SECRET=

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Providers (only the ones you use)
ELEVENLABS_API_KEY=
LEONARDO_API_KEY=
